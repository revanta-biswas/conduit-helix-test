[
  {
    "root": "conduit-next",
    "stack": "node",
    "runtimeVersion": "20",
    "markerFile": "package.json",
    "installCommands": ["npm ci"],
    "buildCommand": "npm run build -w conduit-next",
    "coverageCommand": "npx vitest run tests/unit/conduit-next/ --coverage --passWithNoTests",
    "noTestsExitCode": 1,
    "dependsOn": [],
    "toolchainSetup": [],
    "coverageReportPath": "../coverage/lcov.info",
    "coverageFormat": "lcov",
    "sourcePaths": ["conduit-next"],
    "testPaths": ["tests/unit/conduit-next", "tests/behavior/steps/story-1.steps.js"],
    "tools": ["eslint", "semgrep", "npm-audit", "gitleaks"],
    "toolInstallCommands": {
      "eslint": "npm install -D eslint@9 (already a conduit-next devDependency, installed via root npm install)",
      "semgrep": "pip install \"semgrep==1.127.0\"",
      "npm-audit": "true",
      "gitleaks": "gitleaks_version=8.21.2; curl -sSfL \"https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}/gitleaks_${gitleaks_version}_linux_x64.tar.gz\" | tar xz -C /usr/local/bin gitleaks"
    }
  }
]
